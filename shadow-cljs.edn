{:http {:port 9633},
 ;; All compiler paths and JVM dependencies are declared in deps.edn.
 ;; Sol application exports belong to eta-mu, not this Muse compiler.
 :deps true,
 :nrepl {:port 4501},
 :js-options {:js-provider :import},
 :builds
 {:test
   {:target :node-test,
    :output-to "target/test/test.cjs",
     :ns-regexp "(open-hax\\.sol\\..*-test$|eta-mu\\..*-test$)",
    :autorun false,
    :js-options {:resolve {"@open-hax/eta-mu-cli" {:target :file
                                                       :file "test/js/eta_mu_cli_test_stub.cjs"}}},
    :compiler-options
    {:output-feature-set :es-next,
     :macros {:open-hax.sol.macros true},
     :infer-externs false}},
    :daemon
    {:target :esm,
     :runtime :node,
     :output-dir "dist-daemon",
     :modules {:daemon {:init-fn eta-mu.daemon.core/init}},
     :build-hooks [(eta-mu.daemon.build/emit-package-json)],
     :js-options {:js-provider :import},
     :compiler-options
     {:output-feature-set :es-next,
      :optimizations :simple,
      :source-map false,
      :infer-externs false,
      :warnings {:infer-warning false}}},
    :opencode-plugin
    {:target :esm,
     :runtime :node,
     :output-dir ".opencode/dist",
     :modules
     {:eta-mu-actors
      {:exports
       {:EtaMuActorsPlugin eta-mu.gen.opencode-plugin/plugin}}},
     :build-hooks [(eta-mu.opencode.build/generate-entrypoint)
                   (eta-mu.opencode.build/emit-host-config)],
     :js-options
     {:js-provider :import,
      :keep-as-import #{"zod"}},
     :compiler-options
     {:output-feature-set :es-next,
      :optimizations :simple,
      :source-map false,
      :infer-externs false,
      :warnings {:infer-warning false}}},
    :mcp-server
    {:target :esm,
     :runtime :node,
     :output-dir ".mcp/dist",
     :modules {:receipt-river {:init-fn eta-mu.gen.mcp-server/init}},
     :build-hooks [(eta-mu.mcp.build/generate-entrypoint)
                   (eta-mu.mcp.build/emit-host-config)],
     :js-options
     {:js-provider :import,
      :keep-as-import #{"zod"
                         "@modelcontextprotocol/sdk/server/mcp.js"
                         "@modelcontextprotocol/sdk/server/stdio.js"}},
     :compiler-options
     {:output-feature-set :es-next,
      :optimizations :simple,
      :source-map false,
      :infer-externs false,
      :warnings {:infer-warning false}}},
    :claude-server
    {:target :esm,
     :runtime :node,
     :output-dir ".claude/dist",
     :modules {:claude-server {:init-fn eta-mu.gen.claude-server/init}},
     :build-hooks [(eta-mu.claude.build/generate-entrypoint)
                   (eta-mu.claude.build/emit-host-config)],
     :js-options
     {:js-provider :import,
      :keep-as-import #{"zod"
                         "@modelcontextprotocol/sdk/server/mcp.js"
                         "@modelcontextprotocol/sdk/server/stdio.js"}},
     :compiler-options
     {:output-feature-set :es-next,
      :optimizations :simple,
      :source-map false,
      :infer-externs false,
      :warnings {:infer-warning false}}}}}
